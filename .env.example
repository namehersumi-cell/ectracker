# ---------------------------------------------------------------------------
# EC Price Tracker configuration. Copy to `.env` and fill in what you need.
# Everything is optional — the app boots and runs without any of it.
# ---------------------------------------------------------------------------

# Port the server listens on.
PORT=12000

# --- Gemini -----------------------------------------------------------------
# Without this the app runs in SIMULATED mode: readings are generated locally
# so the whole product is usable for a demo, and every reading is labelled
# "simulated" in the UI rather than being passed off as real data.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash
GEMINI_DAILY_LIMIT=1500

# --- Telegram ---------------------------------------------------------------
# Create a bot with @BotFather, then add it to your chat/group and read the
# chat ID from @userinfobot or the getUpdates API.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Automation -------------------------------------------------------------
# Shared secret for GET /api/cron/run-checks and /api/cron/digest.
CRON_SECRET=

# --- Access gate ------------------------------------------------------------
# 4-6 digit PIN. Prefer APP_PIN_HASH (sha256 of the PIN) so the plaintext PIN
# never sits in the environment. Generate with:
#   node -e "console.log(require('crypto').createHash('sha256').update('1234').digest('hex'))"
APP_PIN=
APP_PIN_HASH=

# Signs the 30-day session cookie. Set this in production so sessions survive
# a restart; if unset a random secret is generated at boot.
SESSION_SECRET=

# --- Storage ----------------------------------------------------------------
# Default is a local JSON document store (zero setup). For Firestore, set
# FIRESTORE_ENABLED=true and supply credentials.
FIRESTORE_ENABLED=false
GOOGLE_APPLICATION_CREDENTIALS=
# Or inline the service account JSON:
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Runtime ----------------------------------------------------------------
NODE_ENV=development
DATA_DIR=
